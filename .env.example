# Public site origin — used for canonical URLs, Open Graph and sitemap.xml.
# Leave unset until the production domain is confirmed.
VITE_SITE_URL=

# Enquiry delivery (server-side only — set in the hosting dashboard, never commit).
# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
# Option B: POST the JSON enquiry to a webhook (CRM, Zapier, Make, Google Apps Script…)
ENQUIRY_WEBHOOK_URL=
